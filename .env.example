# --- Pflicht ---
# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# --- Optional ---
# Standardmodell (aendern falls du z.B. gpt-4.1-mini oder gpt-4o nutzen willst)
OPENAI_MODEL=gpt-4o-mini

# Jina Reader ist kostenlos ohne Key nutzbar. Fuer hoehere Rate-Limits:
# https://jina.ai/reader#pricing
# JINA_API_KEY=jina_...

# Fuer examples/run-example.js
# EXAMPLE_URL=https://...
# EXAMPLE_COMPANY=Ford-Werke GmbH

# --- Neon Postgres (Persistenz) ---
# Wird von `neon link` / `neon env pull` automatisch geschrieben.
# Ohne DATABASE_URL laeuft der Bot wie bisher (nur JSON-Output, kein DB-Write).
# DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require

# --- HubSpot Private App (fuer CRM-Sync) ---
# Anleitung: HubSpot -> Settings -> Integrations -> Private Apps -> Create private app
# Scopes: crm.objects.companies.read, crm.objects.contacts.read,
#         crm.objects.deals.read, crm.lists.read, oauth
# HUBSPOT_TOKEN=pat-eu1-...
